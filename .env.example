# 이 파일은 템플릿입니다. 복사해서 .env.local 또는 .env 로 만들고 사용하세요.
#   cp .env.example .env

# ────────────────────────────────────────────────────────────────────
# 서버 바인딩
# ────────────────────────────────────────────────────────────────────
PORT=3300
HOST=0.0.0.0

# 데이터(SQLite/PDF/JSON/exports) 저장 경로. 미설정 시 ./data 사용.
# 서버 배포 권장: /var/lib/compass-doc-ai
COMPASS_DATA_DIR=./data

# Next.js 텔레메트리 비활성
NEXT_TELEMETRY_DISABLED=1

# ────────────────────────────────────────────────────────────────────
# opendataloader-pdf hybrid 백엔드 (이미지 PDF / OCR 처리)
#
# 설정 시 동작:
#   ① opendataloader-pdf 호출 시 hybrid="docling-fast" 자동 적용
#   ② 변환 결과가 비어있으면(이미지 PDF) hybrid full + OCR 로 자동 재시도
#
# 백엔드는 별도 Python 서버(opendataloader-pdf-hybrid)로 띄워야 합니다.
# 자세한 설치/실행은 SERVER.md 의 12. 섹션 참고.
#
# 미설정 시: 디지털 PDF 만 처리 (이미지 PDF 는 빈 결과)
# ────────────────────────────────────────────────────────────────────
# COMPASS_HYBRID_URL=http://127.0.0.1:5002
# COMPASS_HYBRID_BACKEND=docling-fast
# COMPASS_HYBRID_TIMEOUT_MS=180000

# ────────────────────────────────────────────────────────────────────
# (Electron 전용) GitHub publish 토큰. 데스크톱 빌드 publish 시에만 필요.
# ────────────────────────────────────────────────────────────────────
# GH_TOKEN=github_pat_xxxxxxxxxxxx

# ────────────────────────────────────────────────────────────────────
# (Electron 전용) Azure Trusted Signing 코드 서명 자격 증명.
# `npm run dist` / `dist:publish` 시 electron-builder 가 Microsoft Entra ID
# 인증에 사용한다(EnvironmentCredential). 서명을 켜려면 아래 3개가 필요하며,
# 계정/프로파일명은 electron-builder.yml 의 azureSignOptions 에 설정한다.
# 발급/설정 절차는 docs/CODE_SIGNING.md 참고. 값이 없으면 서명은 건너뛴다.
# ────────────────────────────────────────────────────────────────────
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
